{
  "name": "reviseo-ai-code-review",
  "displayName": "Reviseo - AI Code Review",
  "description": "Persona-based AI code review prompt generator",
  "version": "1.0.0",
  "publisher": "TaurusOSS",
  "repository": {
    "type": "git",
    "url": "https://github.com/TaurusOSS/reviseo.git"
  },
  "bugs": {
    "url": "https://github.com/TaurusOSS/reviseo/issues"
  },
  "homepage": "https://github.com/TaurusOSS/reviseo#readme",
  "icon": "resources/reviseo-icon.png",
  "galleryBanner": {
    "color": "#1e1e2e",
    "theme": "dark"
  },
  "keywords": [
    "code review",
    "ai",
    "personas",
    "github",
    "mcp",
    "prompt",
    "pull request"
  ],
  "engines": {
    "vscode": "^1.120.0"
  },
  "categories": [
    "AI",
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "reviseo",
          "title": "Reviseo",
          "icon": "resources/reviseo-icon.png"
        }
      ]
    },
    "views": {
      "reviseo": [
        {
          "id": "reviseo.sidebar",
          "name": "Reviseo - AI Code Review",
          "icon": "$(eye)"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "reviseo.sidebar",
        "contents": "Welcome to Reviseo!\n\nGenerate structured AI code review prompts using personas.\n\n[Open Reviseo](command:reviseo.openPanel)"
      }
    ],
    "commands": [
      {
        "command": "reviseo.openPanel",
        "title": "Reviseo: Open Review Panel",
        "icon": "$(eye)"
      },
      {
        "command": "reviseo.managePersonas",
        "title": "Reviseo: Manage Personas"
      },
      {
        "command": "reviseo.generatePrompt",
        "title": "Reviseo: Generate Review Prompt"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "reviseo.openPanel"
        },
        {
          "command": "reviseo.managePersonas"
        },
        {
          "command": "reviseo.generatePrompt"
        }
      ],
      "editor/title": [
        {
          "command": "reviseo.openPanel",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "^25.9.1",
    "@types/vscode": "^1.120.0",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "eslint": "^10.4.1",
    "eslint-plugin-boundaries": "^6.0.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.1"
  }
}
