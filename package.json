{
  "name": "reviseo",
  "displayName": "Reviseo",
  "description": "AI Persona based code review",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.110.0"
  },
  "categories": [
    "Other",
    "AI"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "reviseo",
          "title": "Reviseo",
          "icon": "resources/reviseo-icon.svg"
        }
      ]
    },
    "views": {
      "reviseo": [
        {
          "id": "reviseo.sidebar",
          "name": "Reviseo",
          "icon": "$(eye)"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "reviseo.sidebar",
        "contents": "Welcome to Reviseo!\n\nGenerate structured AI code review prompts using personas.\n\n[Open Reviseo](command:reviseo.openPanel)"
      }
    ],
    "commands": [
      {
        "command": "reviseo.openPanel",
        "title": "Reviseo: Open Review Panel",
        "icon": "$(eye)"
      },
      {
        "command": "reviseo.managePersonas",
        "title": "Reviseo: Manage Personas"
      },
      {
        "command": "reviseo.generatePrompt",
        "title": "Reviseo: Generate Review Prompt"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "reviseo.openPanel"
        },
        {
          "command": "reviseo.managePersonas"
        },
        {
          "command": "reviseo.generatePrompt"
        }
      ],
      "editor/title": [
        {
          "command": "reviseo.openPanel",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "^25.9.0",
    "@types/vscode": "^1.120.0",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "eslint": "^10.4.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.4"
  }
}
